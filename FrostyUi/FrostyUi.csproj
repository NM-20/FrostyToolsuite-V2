    </AvaloniaResource>
    <AvaloniaResource Include="Resources\Ui\Theming\Default\Fonts\Inter\Inter-Light.ttf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </AvaloniaResource>
    <AvaloniaResource Include="Resources\Ui\Theming\Default\Fonts\Inter\Inter-Medium.ttf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </AvaloniaResource>
    <AvaloniaResource Include="Resources\Ui\Theming\Default\Fonts\Inter\Inter-Regular.ttf">
