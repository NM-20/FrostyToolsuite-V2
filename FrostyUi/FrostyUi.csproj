<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Frosty.Ui</RootNamespace>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Label="Avalonia">
    <AvaloniaUseCompiledBindingsByDefault>True</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\Ui\Theming\Default\Fonts\DMMono\DMMono-Italic.ttf" />
    <None Remove="Resources\Ui\Theming\Default\Fonts\DMMono\DMMono-Light.ttf" />
    <None Remove="Resources\Ui\Theming\Default\Fonts\DMMono\DMMono-LightItalic.ttf" />
    <None Remove="Resources\Ui\Theming\Default\Fonts\DMMono\DMMono-Medium.ttf" />
    <None Remove="Resources\Ui\Theming\Default\Fonts\DMMono\DMMono-MediumItalic.ttf" />
    <None Remove="Resources\Ui\Theming\Default\Fonts\DMMono\DMMono-Regular.ttf" />
    <None Remove="Resources\Ui\Theming\Default\Fonts\Inter\Inter-Bold.ttf" />
    <None Remove="Resources\Ui\Theming\Default\Fonts\Inter\Inter-Light.ttf" />
    <None Remove="Resources\Ui\Theming\Default\Fonts\Inter\Inter-Medium.ttf" />
    <None Remove="Resources\Ui\Theming\Default\Fonts\Inter\Inter-Regular.ttf" />
    <None Remove="Resources\Ui\Theming\Default\Fonts\Inter\Inter-SemiBold.ttf" />
    <None Remove="Resources\Ui\Theming\Default\Fonts\Inter\Inter-Thin.ttf" />
    <None Remove="Resources\Ui\Theming\Default\Images\SVGs\Close.svg" />
    <None Remove="Resources\Ui\Theming\Default\Images\SVGs\Maximize.svg" />
    <None Remove="Resources\Ui\Theming\Default\Images\SVGs\Minimize.svg" />
    <None Remove="Resources\Ui\Theming\Default\Images\SVGs\RestoreDown.svg" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Resources\Ui\Theming\Default\Fonts\DMMono\DMMono-Italic.ttf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </AvaloniaResource>
    <AvaloniaResource Include="Resources\Ui\Theming\Default\Fonts\DMMono\DMMono-Light.ttf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </AvaloniaResource>
    <AvaloniaResource Include="Resources\Ui\Theming\Default\Fonts\DMMono\DMMono-LightItalic.ttf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
