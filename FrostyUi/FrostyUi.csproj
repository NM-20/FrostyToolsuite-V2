    <AvaloniaResource Include="Resources\Ui\Theming\Default\Fonts\DMMono\DMMono-MediumItalic.ttf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </AvaloniaResource>
    <AvaloniaResource Include="Resources\Ui\Theming\Default\Fonts\DMMono\DMMono-Regular.ttf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </AvaloniaResource>
    <AvaloniaResource Include="Resources\Ui\Theming\Default\Fonts\Inter\Inter-Bold.ttf">
