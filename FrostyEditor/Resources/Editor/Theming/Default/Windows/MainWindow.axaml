<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:FrostyEditor.ViewModels"
                    xmlns:windows="using:FrostyEditor.Views.Windows"
                    x:DataType="vm:MainWindowViewModel">
  <ControlTheme x:Key="{x:Type windows:MainWindow}"
                BasedOn="{StaticResource {x:Type Window}}"
                TargetType="windows:MainWindow">
    <Setter Property="Title"
            Value="{DynamicResource Str_Global_ProgramTitle}"/>

    <Setter Property="Content">
      <Template>
        <ContentControl>
          <vm:MainWindowViewModel/>
        </ContentControl>
      </Template>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
