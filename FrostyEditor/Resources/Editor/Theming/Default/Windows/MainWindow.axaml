<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:FrostyEditor.ViewModels"
                    xmlns:windows="using:FrostyEditor.Views.Windows"
                    x:DataType="vm:MainWindowViewModel">
  <ControlTheme x:Key="{x:Type windows:MainWindow}"
                TargetType="windows:MainWindow">
    <Setter Property="Icon"
            Value="{DynamicResource Image_Global_ProgramIcon}"/>
    <Setter Property="Title"
            Value="{DynamicResource Str_Global_ProgramTitle}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <TextBlock Text="{Binding Greeting}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
