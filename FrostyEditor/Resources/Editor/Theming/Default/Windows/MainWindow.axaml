<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:FrostyEditor.ViewModels"
                    xmlns:windows="using:FrostyEditor.Views.Windows"
                    x:DataType="vm:MainWindowViewModel">
  <ControlTheme x:Key="{x:Type windows:MainWindow}"
                TargetType="windows:MainWindow">
    <Setter Property="Icon"
            Value="{StaticResource Image_Global_ProgramWindowIcon}"/>
    <Setter Property="Title"
            Value="{DynamicResource Str_Global_ProgramTitle}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <ContentControl>
          <vm:MainWindowViewModel/>
        </ContentControl>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
