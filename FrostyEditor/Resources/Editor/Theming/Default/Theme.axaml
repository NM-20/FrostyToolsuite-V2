<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:xaml="using:Frosty.Ui.Xaml">
  <ResourceDictionary.MergedDictionaries>
    <!-- Core resources, these MUST be positioned at the top, as `StaticResource` markup is used to access them. -->
    <xaml:RuntimeResourceInclude>avares://FrostyEditor/Resources/Editor/Theming/Default/Colors.axaml</xaml:RuntimeResourceInclude>
    <xaml:RuntimeResourceInclude>avares://FrostyEditor/Resources/Editor/Theming/Default/Converters.axaml</xaml:RuntimeResourceInclude>
    <xaml:RuntimeResourceInclude>avares://FrostyEditor/Resources/Editor/Theming/Default/Images.axaml</xaml:RuntimeResourceInclude>
  
    <xaml:RuntimeResourceInclude>avares://FrostyEditor/Resources/Editor/Theming/Default/Controls.axaml</xaml:RuntimeResourceInclude>
    <xaml:RuntimeResourceInclude>avares://FrostyEditor/Resources/Editor/Theming/Default/Windows.axaml</xaml:RuntimeResourceInclude>
  </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
