<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:media="using:Frosty.Ui.Media">
  <ResourceDictionary.MergedDictionaries>
    <!-- Core resources, these MUST be positioned at the top, as `StaticResource` markup is used to access them. -->
    <media:RuntimeResourceInclude>avares://FrostyEditor/Resources/Editor/Theming/Default/Converters.axaml</media:RuntimeResourceInclude>
    <media:RuntimeResourceInclude>avares://FrostyEditor/Resources/Editor/Theming/Default/Images.axaml</media:RuntimeResourceInclude>
  
    <media:RuntimeResourceInclude>avares://FrostyEditor/Resources/Editor/Theming/Default/Controls.axaml</media:RuntimeResourceInclude>
    <media:RuntimeResourceInclude>avares://FrostyEditor/Resources/Editor/Theming/Default/Windows.axaml</media:RuntimeResourceInclude>
  </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
